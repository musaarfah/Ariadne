# Get a key at themoviedb.org -> Settings -> API. Free.
TMDB_API_KEY=

# Defaults match infra/docker-compose.yml. Non-standard ports avoid clashing with any
# Postgres or Redis already running locally.
DATABASE_URL=postgresql+psycopg://ariadne:ariadne@localhost:5433/ariadne
TEST_DATABASE_URL=postgresql+psycopg://ariadne:ariadne@localhost:5433/ariadne_test
REDIS_URL=redis://localhost:6380/0
